{
	"name": "@time-craft/api",
	"version": "1.1.0",
	"private": true,
	"type": "module",
	"engines": {
		"node": "22.x"
	},
	"exports": {
		".": {
			"types": "./src/app.ts"
		},
		"./container": "./src/container.ts",
		"./seed": "./src/seed.ts"
	},
	"scripts": {
		"dev": "bun --env-file=../../.env --watch --port=3000 src/index.ts",
		"build": "bun scripts/build.ts",
		"lint": "biome check .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p scripts",
		"test": "bun test",
		"db:seed": "bun --env-file=../../.env scripts/seed.ts"
	},
	"dependencies": {
		"@hono/zod-validator": "^0.9.1",
		"@neondatabase/serverless": "^1.2.0",
		"@time-craft/core": "workspace:*",
		"@time-craft/db": "workspace:*",
		"@upstash/qstash": "^2.12.0",
		"better-auth": "^1.7.11",
		"drizzle-orm": "^0.45.4",
		"hono": "^4.13.13",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@electric-sql/pglite": "^0.5.10",
		"@time-craft/tsconfig": "workspace:*",
		"@types/bun": "1.4.3",
		"@types/node": "^22",
		"@types/web-push": "^3.6.4",
		"typescript": "^6.0.3"
	}
}
