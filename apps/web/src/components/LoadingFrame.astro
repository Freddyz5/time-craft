---
// What a static page shows while its island loads: the mark, the same as the
// islands' own loading state (and brand/mark.svg).
---

<div class="grid min-h-dvh place-items-center px-4" role="status">
	<div class="flex flex-col items-center gap-4 font-semibold text-ink-soft">
		<svg viewBox="0 0 48 48" class="size-16" aria-hidden="true">
			<rect x="9" y="3" width="12" height="10" rx="3" fill="#ffcd1a"></rect>
			<rect x="27" y="3" width="12" height="10" rx="3" fill="#ffcd1a"></rect>
			<rect x="2" y="10" width="44" height="35" rx="5" fill="#ffcd1a"></rect>
			<path d="M2 37h44v3a5 5 0 0 1-5 5H7a5 5 0 0 1-5-5z" fill="#d9a400"></path>
			<rect x="5" y="12.5" width="38" height="3" rx="1.5" fill="#fff" opacity="0.45"></rect>
			<path d="M24 18.5v9.5l6.5 3.5" fill="none" stroke="#171a20" stroke-width="4.5" stroke-linecap="round" stroke-linejoin="round"></path>
		</svg>
		<span>Cargando…</span>
	</div>
</div>
