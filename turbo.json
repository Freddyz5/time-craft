{
	"$schema": "https://turborepo.dev/schema.json",
	"globalDependencies": ["package.json", "bunfig.toml"],
	"tasks": {
		"transit": {
			"dependsOn": ["^transit"]
		},
		"build": {
			"dependsOn": ["^build", "transit"],
			"outputs": ["dist/**"]
		},
		"@time-craft/web#build": {
			"dependsOn": ["^build", "transit"],
			"outputs": ["dist/**"],
			"env": ["VAPID_PUBLIC_KEY", "GOOGLE_CLIENT_ID"]
		},
		"//#lint:root": {},
		"lint": {
			"dependsOn": ["//#lint:root"]
		},
		"typecheck": {
			"dependsOn": ["transit"]
		},
		"test": {
			"dependsOn": ["transit"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"@time-craft/web#dev": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["API_DEV_URL", "VAPID_PUBLIC_KEY", "GOOGLE_CLIENT_ID"]
		},
		"db:generate": {
			"cache": false
		},
		"db:migrate": {
			"cache": false,
			"passThroughEnv": ["DATABASE_URL_UNPOOLED"]
		},
		"db:studio": {
			"cache": false,
			"persistent": true,
			"passThroughEnv": ["DATABASE_URL_UNPOOLED"]
		},
		"db:seed": {
			"cache": false,
			"passThroughEnv": [
				"DATABASE_URL_UNPOOLED",
				"BETTER_AUTH_SECRET",
				"BETTER_AUTH_URL",
				"SEED_*"
			]
		}
	}
}
