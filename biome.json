{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": ["**", "!packages/db/migrations"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUndeclaredDependencies": "error"
			}
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"overrides": [
		{
			"includes": ["apps/*/src/**", "packages/*/src/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedGlobals": {
							"level": "error",
							"options": {
								"deniedGlobals": {
									"Bun": "Deployed code runs on Node (Vercel) or in the browser: use Node or Web APIs instead of Bun APIs."
								}
							}
						},
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["bun", "bun:*"],
										"message": "Deployed code runs on Node (Vercel) or in the browser: Bun modules are only allowed in tests and scripts."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/core/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": [
											"drizzle-orm",
											"drizzle-orm/**",
											"drizzle-kit",
											"hono",
											"hono/**",
											"@hono/**",
											"better-auth",
											"better-auth/**",
											"@better-auth/**",
											"@upstash/**",
											"web-push",
											"@neondatabase/**",
											"@time-craft/db",
											"@time-craft/db/**",
											"**/db/src/**"
										],
										"message": "packages/core holds only domain rules: infrastructure lives in apps/api adapters behind core's ports."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["packages/core/src/**", "!**/*.test.ts"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"patterns": [
									{
										"group": ["bun", "bun:*"],
										"message": "Deployed code runs on Node (Vercel) or in the browser: Bun modules are only allowed in tests and scripts."
									},
									{
										"group": [
											"drizzle-orm",
											"drizzle-orm/**",
											"drizzle-kit",
											"hono",
											"hono/**",
											"@hono/**",
											"better-auth",
											"better-auth/**",
											"@better-auth/**",
											"@upstash/**",
											"web-push",
											"@neondatabase/**",
											"@time-craft/db",
											"@time-craft/db/**",
											"**/db/src/**"
										],
										"message": "packages/core holds only domain rules: infrastructure lives in apps/api adapters behind core's ports."
									}
								]
							}
						}
					}
				}
			}
		},
		{
			"includes": ["**/*.astro"],
			"linter": {
				"rules": {
					"style": {
						"useConst": "off",
						"useImportType": "off"
					},
					"correctness": {
						"noUnusedVariables": "off",
						"noUnusedImports": "off"
					}
				}
			}
		}
	]
}
