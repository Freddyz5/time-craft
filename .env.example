# Copy to .env and fill in per environment (local, preview/dev, production).
# The api validates its variables at startup with a zod schema (apps/api/src/env.ts)
# and fails fast if one is missing; the seed checks its own.

# --- Database (Neon) ---
# Pooled connection string, used at runtime.
DATABASE_URL=
# Direct (unpooled) connection string, used for migrations.
DATABASE_URL_UNPOOLED=

# --- Seed (bun run db:seed, against DATABASE_URL_UNPOOLED) ---
# Creates the family, both parents (they sign in with Google, so use their
# Google emails), the game/TV activities, the child's login, a global quota
# policy and the family's recovery code (printed once). Safe to rerun: it only
# creates what is missing and never changes existing rows. It also needs
# BETTER_AUTH_SECRET and BETTER_AUTH_URL.
SEED_FAMILY_NAME=
SEED_PARENT_1_NAME=
SEED_PARENT_1_EMAIL=
# Optional: a password (8+ characters) for email sign-in, e.g. on previews
# where Google is off. Only set if the parent has none yet.
SEED_PARENT_1_PASSWORD=
SEED_PARENT_2_NAME=
SEED_PARENT_2_EMAIL=
SEED_PARENT_2_PASSWORD=
# The child's login: username (3-30 letters, digits, dots or underscores)
# and a PIN of 6 to 12 digits. Leave all three empty to create it from the app.
SEED_CHILD_NAME=
SEED_CHILD_USERNAME=
SEED_CHILD_PIN=
# Initial limits of the child's global policy (defaults: 60 and 300).
SEED_DAILY_LIMIT_MINUTES=
SEED_WEEKLY_LIMIT_MINUTES=

# --- Auth (Better Auth) ---
# Secret used to sign sessions and tokens, 32+ characters:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Origin where the browser reaches /api/auth: the web's domain in Vercel
# (it rewrites /api/* to the api). In local development the web's dev server
# proxies /api to the api, so it is the web's: http://localhost:4321.
BETTER_AUTH_URL=

# --- Google sign-in (only enabled on dev and production) ---
# Leave both empty to turn Google off (previews, local). Redirect URI to
# register in Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
# OAuth client ID from Google Cloud. The web reads it too (at build time) to
# show "Continuar con Google" only where Google is on; the ID is public.
GOOGLE_CLIENT_ID=
# OAuth client secret from Google Cloud.
GOOGLE_CLIENT_SECRET=

# --- Scheduled alerts (Upstash QStash) ---
# Token to publish and cancel messages.
QSTASH_TOKEN=
# Current signing key, to verify callback signatures.
QSTASH_CURRENT_SIGNING_KEY=
# Next signing key, to verify callback signatures during key rotation.
QSTASH_NEXT_SIGNING_KEY=
# Public api URL that QStash calls back (at /internal/jobs).
PUBLIC_API_URL=
# Optional: only for QStash's local development server
# (npx @upstash/qstash-cli dev), e.g. http://localhost:8080.
QSTASH_URL=

# --- Web Push (VAPID) ---
# Generate the pair once with: bunx web-push generate-vapid-keys
# Public VAPID key. The web reads it too (at build time, astro:env), to
# subscribe to push: set it in the web's Vercel project as well.
VAPID_PUBLIC_KEY=
# Private VAPID key, used by the api to sign push messages.
VAPID_PRIVATE_KEY=
# Contact for the push service, as a mailto: or https: URL.
VAPID_SUBJECT=

# --- Web (apps/web) ---
# Optional: where the web's dev server proxies /api (default
# http://localhost:3000).
API_DEV_URL=
