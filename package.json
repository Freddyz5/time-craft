{
	"name": "time-craft",
	"private": true,
	"packageManager": "bun@1.4.3",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"lint:root": "biome check *.json scripts",
		"format": "biome check --write .",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test",
		"db:generate": "turbo run db:generate",
		"db:migrate": "turbo run db:migrate",
		"db:studio": "turbo run db:studio",
		"db:seed": "turbo run db:seed",
		"e2e": "bun --cwd=apps/e2e run e2e",
		"e2e:smoke": "bun --cwd=apps/e2e run smoke",
		"e2e:family:create": "bun --cwd=apps/e2e run family:create",
		"e2e:family:delete": "bun --cwd=apps/e2e run family:delete",
		"release": "semantic-release --extends ./scripts/release/config.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@semantic-release/changelog": "7.0.0",
		"@semantic-release/commit-analyzer": "13.0.1",
		"@semantic-release/git": "11.0.1",
		"@semantic-release/release-notes-generator": "14.1.1",
		"conventional-changelog-conventionalcommits": "9.3.1",
		"semantic-release": "25.0.9",
		"turbo": "2.11.9"
	}
}
